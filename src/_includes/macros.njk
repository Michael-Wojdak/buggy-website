{% macro bugImage(entry, image) %}
    <img
        src="/images/{{ image.path }}"
        alt="{{ entry.name | default('', true) | escape }}"
        title="{{ image.location }}{% if image.location %}, {% endif %}{{ image.date }}{% if (image.location or image.date) and image.desc %}&#10;{% endif %}{{ image.desc }}"
        loading="lazy"
    >
{% endmacro %}


{% macro bugCard(entry) %}
    <article
        class="search-result-card"
        data-name="{{ entry.name | default("", true) | escape }}"
        data-sci="{{ entry.scientific | default("", true) | escape }}"
        data-desc="{{ entry.desc | default("", true) | escape }}"
        data-category="{{ entry.order | default("", true) | escape }}"
        data-sub_category="{{ entry.group | default("", true) | escape }}"
        data-tags="{{ (entry.tags | default([], true)) | join(' ') | escape }}"
        data-dates="{% for image in entry.images %}{% if image.date %}{{image.date}},{%endif%}{%endfor%}"
    >
    <h2>
        <a class="title" href="/entries/{{ entry.id | slugify  }}/">
        {{ entry.name }}
        </a>
    </h2>

    {% if entry.images and entry.images.length %}
    <div class="image-box">
        <a href="/entries/{{ entry.id | slugify }}/">
        <img
            src="/images/{{ entry.images[0].path }}"
            alt="{{ entry.name | default('', true) | escape }}"
            loading="lazy"
        >
        </a>
    </div>
    {% endif %}

    </article>
{% endmacro %}